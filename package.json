{
  "name": "@regulaforensics/document-reader-webclient",
  "version": "0.0.0",
  "description": "Regula Document Reader js client for the browser and node.js based on axios",
  "author": "Regula Forensics, Inc.",
  "keywords": [
    "document-reader-webclient",
    "document reader",
    "document recognition",
    "regulaforensics",
    "regula"
  ],
  "license": "MIT",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com/regulaforensics/DocumentReader-api-js-client"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "eslint --fix",
    "build": "npm run check-types && vite build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "base64-arraybuffer": "^1.0.2",
    "pako": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/pako": "^3.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.4"
  }
}
